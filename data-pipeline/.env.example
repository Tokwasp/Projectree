# data-pipeline 환경변수 (키 이름만 — 실값은 .env 에, .env 는 커밋 금지)
# ---------------------------------------------------------------------------

# 그래프 정본 PostgreSQL (토폴로지 A). alembic·파이프라인이 이 URL 을 사용한다.
DATABASE_URL=postgresql+psycopg://pipeline:pipeline@localhost:5432/pipeline
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# FastAPI internal-service limits. Authentication is supplied by Spring later.
API_HOST=127.0.0.1
API_PORT=8000
API_MAX_REQUEST_BODY_BYTES=1048576
API_GRACEFUL_SHUTDOWN_SECONDS=20

# 카테고리 설정 파일 경로 (미지정 시 data_pipeline/config/categories.json).
# §T 미확정 — 값 교체는 이 파일 수정 + 재시딩 마이그레이션 1개로 끝난다.
# CATEGORY_CONFIG_PATH=

# 검색기 설정 스텁 (M1 에서는 구현 없음. 코드 상수 금지 — 전부 여기서 주입).
RETRIEVAL_DECISION_TOP_K=3
RETRIEVAL_MEETING_MAX_CANDIDATES=5
RETRIEVAL_EMBEDDED_ACTION_TOP_K=5
RETRIEVAL_NODE_TOP_K=5
# 비워 두면 유사도 하한을 적용하지 않는다. 설정 시 -1.0~1.0.
RETRIEVAL_MIN_SIMILARITY=
RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_EMBEDDING_VERSION=v1
RETRIEVAL_EMBEDDING_DIM=1536
RETRIEVAL_TEXT_EXTENSION=pg_bigm
RETRIEVAL_CONFIG_VERSION=retrieval-v1

# STT adapter. Keep fake for local S3/SQS integration. The fixture is optional.
STT_ADAPTER=fake
STT_FAKE_RESPONSE_PATH=
CLOVA_INVOKE_URL=
CLOVA_SECRET=
CLOVA_TIMEOUT_SECONDS=900

# S3 ObjectCreated -> SQS -> local worker. Use dedicated test resources first.
APP_ENV=test
AWS_REGION=ap-northeast-2
SQS_QUEUE_URL=
S3_ALLOWED_BUCKETS=
S3_INPUT_PREFIX=audio-input/
S3_ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.flac,.ogg,.aac
S3_MAX_AUDIO_BYTES=104857600
# AUDIO_TEMP_DIRECTORY=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=900
SQS_HEARTBEAT_INTERVAL_SECONDS=300
SQS_HEARTBEAT_MAX_EXTENSIONS=6
UPLOAD_PROCESSING_TIMEOUT_SECONDS=1800
LLM_ADAPTER=fake
# Reserved for the later analysis worker; this ingestion worker does not embed.
EMBEDDING_ADAPTER=fake
# Analysis Worker에서 실제 adapter를 사용할 때만 gms로 변경한다.
# EMBEDDING_ADAPTER=gms
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_TIMEOUT_SECONDS=60
# EMBEDDING_RETRY_COUNT=2

# Analysis Worker B 모델. 실제 실행은 gms/openai 중 하나가 필수다.
B_MODEL_ADAPTER=
# B_MODEL_API_KEY=          # 비우면 GMS_KEY
# B_MODEL_BASE_URL=         # 비우면 OPENAI_BASE_URL
# B_MODEL_NAME=             # 비우면 OPENAI_MODEL
# B_MODEL_VERSION=v1
# B_MODEL_TIMEOUT_SECONDS=120

# SSAFY GMS OpenAI 호환 API — 실제 키는 .env 에만 입력한다.
GMS_KEY=
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
OPENAI_MODEL=gpt-5.2
OPENAI_TEMPERATURE=0

# 선택값. 비워 두면 코드 기본값을 사용한다.
# OPENAI_MAX_OUTPUT_TOKENS=
# OPENAI_TIMEOUT_SECONDS=180
# OPENAI_RETRY_COUNT=2
