# data-pipeline 환경변수 (키 이름만 — 실값은 .env 에, .env 는 커밋 금지)
# ---------------------------------------------------------------------------

# 그래프 정본 PostgreSQL (토폴로지 A). alembic·파이프라인이 이 URL 을 사용한다.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# FastAPI internal-service boundary. 운영/스테이징에서는 token이 필수다.
API_HOST=127.0.0.1
API_PORT=8000
API_MAX_REQUEST_BODY_BYTES=1048576
API_GRACEFUL_SHUTDOWN_SECONDS=20
INTERNAL_API_TOKEN=
# 운영 제품 경로에서는 false. 기존 승인 API의 로컬 호환 검증에만 true.
ENABLE_LEGACY_REVIEW_API=false
# 수동 MERGE/UNMERGE/REMERGE는 과거 호환 코드이며 제품 기본값은 비활성이다.
ENABLE_LEGACY_MANUAL_MERGE_API=false
ENABLE_LEGACY_OPENVIDU_AUDIO_WORKER=false

# 카테고리 설정 파일 경로 (미지정 시 data_pipeline/config/categories.json).
# §T 미확정 — 값 교체는 이 파일 수정 + 재시딩 마이그레이션 1개로 끝난다.
# CATEGORY_CONFIG_PATH=

# 검색기 설정 스텁 (M1 에서는 구현 없음. 코드 상수 금지 — 전부 여기서 주입).
RETRIEVAL_DECISION_TOP_K=3
RETRIEVAL_MEETING_MAX_CANDIDATES=5
RETRIEVAL_EMBEDDED_ACTION_TOP_K=5
RETRIEVAL_NODE_TOP_K=5
# 비워 두면 유사도 하한을 적용하지 않는다. 설정 시 -1.0~1.0.
RETRIEVAL_MIN_SIMILARITY=
RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-small
# v2 contract: Category is NOT part of the embedding input.
# Never mix v1 and v2 vectors in one candidate set.
RETRIEVAL_EMBEDDING_VERSION=node-embedding-v2-no-category
RETRIEVAL_EMBEDDING_DIM=1536
RETRIEVAL_TEXT_EXTENSION=pg_bigm
RETRIEVAL_CONFIG_VERSION=retrieval-v1
# 300개 이상 라벨 사례로 보정하기 전에는 비워 둔다. 둘 중 하나라도 비어
# 있으면 자동 MERGE만 안전하게 CREATE_NEW로 강등되고 자동 Node 생성은 계속된다.
AUTO_MERGE_MIN_SIMILARITY=
AUTO_MERGE_MIN_MARGIN=

# Production-shaped example. Fake adapters live in tests/config/fake/.env.example.fake.
STT_ADAPTER=clova
CLOVA_INVOKE_URL=
CLOVA_SECRET=
CLOVA_TIMEOUT_SECONDS=900

# S3 ObjectCreated -> SQS -> local worker. Use dedicated test resources first.
APP_ENV=production
AWS_REGION=ap-northeast-2
SQS_QUEUE_URL=
# Event v3 입력은 두 큐를 분리한다. 기존 SQS_QUEUE_URL은 일반 S3 이벤트 호환용이다.
RECORDING_READY_QUEUE_URL=
ANALYSIS_COMMAND_QUEUE_URL=
S3_ALLOWED_BUCKETS=
S3_INPUT_PREFIX=audio-input/
S3_ALLOWED_EXTENSIONS=.wav,.mp3,.m4a,.flac,.ogg,.aac
S3_MAX_AUDIO_BYTES=104857600
# AUDIO_TEMP_DIRECTORY=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=900
SQS_HEARTBEAT_INTERVAL_SECONDS=300
SQS_HEARTBEAT_MAX_EXTENSIONS=6
UPLOAD_PROCESSING_TIMEOUT_SECONDS=1800
ANALYSIS_COORDINATOR_CLAIM_TIMEOUT_SECONDS=900
ANALYSIS_COORDINATOR_IDLE_SECONDS=2
LLM_ADAPTER=gms
# 운영 실행은 false. 긴급 차단 또는 외부 호출 없는 검증에서만 true로 전환한다.
# true이면 실제 LLM/Embedding/B-model/Summary client 생성 전에 실패한다.
NO_EXTERNAL_AI_CALLS=false
# 자동 Graph Worker는 Candidate 생성 뒤 Embedding과 B 모델을 함께 사용한다.
EMBEDDING_ADAPTER=gms
# 실제 provider를 사용할 때만 gms로 변경한다.
# EMBEDDING_ADAPTER=gms
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_TIMEOUT_SECONDS=60
# EMBEDDING_RETRY_COUNT=2
# EMBEDDING_RETRY_BACKOFF_SECONDS=0.5

# 자동 Graph Worker B 모델. Fake 통합 점검은 fake, 실제 실행은 gms/openai.
B_MODEL_ADAPTER=gms
# B_MODEL_API_KEY=          # 비우면 GMS_KEY
# B_MODEL_BASE_URL=         # 비우면 OPENAI_BASE_URL
# B_MODEL_NAME=             # 비우면 OPENAI_MODEL
# B_MODEL_VERSION=v1
# B_MODEL_TIMEOUT_SECONDS=120

# Java Result Event v3 / immutable graph snapshot claim-check
OUTBOX_TRANSPORT=result-sqs
PROJECTREE_ANALYSIS_RESULT_QUEUE_URL=
# Optional: STANDARD or FIFO. Java와 Python이 같은 Result Queue를 사용한다.
PROJECTREE_ANALYSIS_RESULT_QUEUE_TYPE=STANDARD
AWS_S3_BUCKET=projectree-bucket
PROJECTREE_GRAPH_SNAPSHOT_PREFIX=graph-snapshots/
# Java MEETING_ANALYSIS_GRAPH_SNAPSHOT_MAX_SIZE_BYTES와 동일한 10 MiB.
PROJECTREE_GRAPH_SNAPSHOT_MAX_SIZE_BYTES=10485760
# 운영 회의록 생성은 GMS adapter를 사용한다. Fake는 tests/config/fake에서만 사용한다.
SUMMARY_ADAPTER=gms

# SSAFY GMS OpenAI 호환 API — 실제 키는 .env 에만 입력한다.
GMS_KEY=
OPENAI_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
OPENAI_MODEL=gpt-5.2
OPENAI_TEMPERATURE=0

# 선택값. 비워 두면 코드 기본값을 사용한다.
# OPENAI_MAX_OUTPUT_TOKENS=
# OPENAI_TIMEOUT_SECONDS=180
# OPENAI_RETRY_COUNT=2
