# .env 템플릿 — 복사해서 .env로 만들고 실제 값으로 채우세요.
#   cp .env.example .env
DB_HOST=localhost
DB_PORT=3306
DB_NAME=projectree
DB_USERNAME=projectree
DB_PASSWORD=change-me

# MySQL 컨테이너 root 비밀번호
MYSQL_ROOT_PASSWORD=change-me-root

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=change-me

# Redis (Upstash) — 세션 저장소. Upstash 콘솔의 Endpoint / Port / Password를 넣는다.
# TLS 필수라 yaml에서 ssl.enabled=true로 고정되어 있다.
REDIS_HOST=your-db.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# CORS — 프론트엔드 origin. 여러 개면 콤마로 구분한다.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 세션 쿠키 — HTTPS 배포 환경에서는 반드시 SESSION_COOKIE_SECURE=true 로 둔다.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
